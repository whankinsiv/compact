import CompactStandardLibrary;

export { verify_proof_wrong_inner_proof }

witness inner_proof(): Opaque<"Uint8Array">;

export ledger attested_value: Field;

// The same contract as `basic`, run with proof bytes the key does not accept.
circuit verify_proof_wrong_inner_proof(value: Field): [] {
    attested_value = disclose(value);

    verifyProof('basic.verifier', inner_proof(), [attested_value]);
}
