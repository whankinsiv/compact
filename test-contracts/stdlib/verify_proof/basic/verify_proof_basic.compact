import CompactStandardLibrary;

export { verify_proof_basic }

witness inner_proof(): Opaque<"Uint8Array">;

export ledger attested_value: Field;

circuit verify_proof_basic(value: Field): [] {
    // verifyProof requires the key to reduce to a constant at compile time, so
    // it can be neither an argument nor a ledger cell. This is the `basic`
    // circuit's vkHash, pinned again in runtime.pass.test.ts.
    const basic_vk = Bytes[0xed, 0xe1, 0xc7, 0x12, 0x91, 0xe0, 0xc6, 0x91,
                           0x9f, 0xa1, 0xe1, 0xb8, 0xae, 0xfe, 0x0d, 0x6f,
                           0x84, 0x98, 0x85, 0x2a, 0x23, 0x97, 0x1f, 0x93,
                           0x6f, 0x3e, 0x3c, 0x48, 0x57, 0x21, 0xa1, 0xba]
                           as VerifyingKeyHash;

    attested_value = disclose(value);

    verifyProof<1>(basic_vk, inner_proof(), [attested_value]);
}
