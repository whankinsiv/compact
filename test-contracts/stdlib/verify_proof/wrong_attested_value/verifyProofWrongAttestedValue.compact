import CompactStandardLibrary;

export { verifyProofWrongAttestedValue }

witness innerProof(): Opaque<"Uint8Array">;

export ledger attestedValue: Field;

// The same contract as `basic`, run with a public input the proof was not made for.
circuit verifyProofWrongAttestedValue(value: Field): [] {
    attestedValue = disclose(value);

    verifyProof('basic.verifier', innerProof(), [attestedValue]);
}
